{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "meraki-home",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-08-08",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": true,
  "secrets": {
    "required": ["BOOKING_ICAL_URL"]
  },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "observability": {
    "enabled": true
  },
  "routes": [
    {
      "pattern": "merakihome.gr",
      "custom_domain": true
    },
    {
      "pattern": "www.merakihome.gr",
      "custom_domain": true
    }
  ]
}
