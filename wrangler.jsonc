{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "meraki-home",
  "compatibility_date": "2026-07-20",
  "workers_dev": true,
  "preview_urls": true,
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  },
  "routes": [
    {
      "pattern": "merakihome.gr",
      "custom_domain": true
    }
  ]
}
