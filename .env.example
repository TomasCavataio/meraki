# URL pública completa, sin barra final. Se usa para canonical, Open Graph y sitemap.
# Producción: dominio canónico sin barra final.
VITE_PUBLIC_SITE_URL=https://merakihome.gr
VITE_BASE_PATH=/

# Base de Vite. En desarrollo y dominios propios debe ser "/".
# En GitHub Project Pages será "/nombre-del-repositorio/".
VITE_BASE_PATH=/
